# ============================================================
# .env.example — PLANTILLA DE CONFIGURACIÓN (sin secretos)
# Copiar a .env y completar los valores reales:
#   Copy-Item .env.example .env
# ============================================================

# --- Identificación de la alumna (llega a las plantillas vía context processor) ---
ALUMNO_NOMBRE=Nombre Apellido Apellido
ALUMNO_SECCION=IEC-C4-N2
ALUMNO_ANIO=2026
NOMBRE_COMERCIAL=HardPoint PC

# --- Django ---
# Generar una nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=coloque-aqui-una-clave-secreta-generada
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver

# --- PostgreSQL ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=tienda_hardware_db
DB_USER=postgres
DB_PASSWORD=su-contrasena-de-postgres
DB_HOST=localhost
DB_PORT=5432

# --- Driver libpq (Windows) ---
# Carpeta bin de PostgreSQL que contiene libpq.dll. Solo se usa
# como respaldo si el binario de psycopg no puede cargarse.
PG_BIN_DIR=C:\Program Files\PostgreSQL\16\bin

# --- HTTPS detrás de un proxy (Nginx) ---
# En local se deja todo en False/vacío: el sitio sigue funcionando
# igual que hoy, por HTTP, sin cookies "Secure" ni HSTS.
# En el servidor (detrás de Nginx con "include proxy_params" y
# Let's Encrypt) se pone DETRAS_DE_PROXY_HTTPS=True y se agrega el
# dominio público a CSRF_TRUSTED_ORIGINS.
DETRAS_DE_PROXY_HTTPS=False
CSRF_TRUSTED_ORIGINS=

# --- Transbank Webpay Plus ---
# Dejar en blanco usa las constantes públicas del propio SDK para
# el ambiente de integración (IntegrationCommerceCodes.WEBPAY_PLUS e
# IntegrationApiKeys.WEBPAY): sirven para probar sin dinero real y
# son las mismas que publica la documentación oficial de Transbank.
# TRANSBANK_AMBIENTE acepta "integracion" o "produccion".
TRANSBANK_AMBIENTE=integracion
TRANSBANK_CODIGO_COMERCIO=
TRANSBANK_API_KEY=
